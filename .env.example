# API Keys (replace with your own)
GEMINI_API_KEY ="Paste your API Key here"
OPENAI_API_KEY ="Paste your API Key here"
SERPAPI_API_KEY ="Paste your API Key here"

# API Server Authentication (deprecated - superseded by per-user JWT auth below;
# kept only so old .env files don't fail to load. Safe to delete this line.)
API_AUTH_KEY="generate_a_secure_key_here"

# JWT auth (required) - generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY="generate_a_long_random_secret_here"

# Database (defaults to a local SQLite file if unset - fine for dev/CI).
# In production, point this at Postgres, e.g.:
# DATABASE_URL="postgresql+psycopg2://user:password@host:5432/erp_agent"
DATABASE_URL="sqlite:///output/erp_agent.db"

# Model Configuration
GEMINI_MODEL = "gemini-3.6-flash"
OPENAI_MODEL = "gpt-4o"
TEMPERATURE = 0.7
MAX_TOKENS = 8192

# Agent Configuration
MAX_ITERATIONS = 10
TIMEOUT_SECONDS = 300
# Per-LLM-call timeout and retry count (see src/config/settings.py for how
# these relate to TIMEOUT_SECONDS above).
LLM_CALL_TIMEOUT_SECONDS = 60
LLM_RETRY_ATTEMPTS = 2

# Logging Configuration
LOG_LEVEL = "INFO"
LOG_FORMAT = "json"

# Memory Configuration
MEMORY_ENABLED = True
MAX_MEMORY_ITEMS = 100

# Application Settings
PROJECT_NAME = "ERP_Consultant_Agent"
ENVIRONMENT = "development"

