# API Keys (replace with your own)
GEMINI_API_KEY ="Your key here"
SERPAPI_API_KEY ="Your key here"
GROQ_API_KEY="Your key here"
OPENAI_API_KEY="Your key here"
ANTHROPIC_API_KEY="Your key here"


# Model Configuration
GEMINI_MODEL="gemini-3.8-flash"
GROQ_MODEL="openai/gpt-oss-120b"
OPENAI_MODEL="gpt-5.6-sol"
ANTHROPIC_MODEL="claude-opus-5"

TEMPERATURE=0.5
MAX_TOKENS=65536

# Agent Configuration
MAX_ITERATIONS = 10
TIMEOUT_SECONDS = 300
# Per-LLM-call timeout and retry count (see src/config/settings.py for how
# these relate to TIMEOUT_SECONDS above).
LLM_CALL_TIMEOUT_SECONDS = 60
LLM_RETRY_ATTEMPTS = 2

# Logging Configuration
LOG_LEVEL = "INFO"
LOG_FORMAT = "json"

# Memory Configuration
MEMORY_ENABLED = True
MAX_MEMORY_ITEMS = 100

# Application Settings
PROJECT_NAME = "ERP_Consultant_Agent"
ENVIRONMENT = "development"

API_AUTH_KEY="Your key here"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# JWT auth (required) - generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY="Your key here"

# Access-token TTL is short-lived (default 15 minutes). Paired with the
# server-side revocable refresh flow. Do not raise this to hours.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token TTL (server-side, revocable).
REFRESH_TOKEN_EXPIRE_DAYS=30

# Pre-authentication state issued between password verification and OTP
# verification. Does not grant authenticated API access by itself.
PENDING_AUTH_EXPIRE_MINUTES=10

# Email OTP (MFA).
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_INTERVAL_SECONDS=60

# Email verification and password reset token TTLs.
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30

# Progressive login protection (account-level backstop; endpoint rate
# limiting is the primary control).
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_DURATION_MINUTES=15

# Authentication cookies. Refresh credentials are delivered as Secure,
# HttpOnly cookies (HttpOnly is hardcoded; it is not a setting).
# AUTH_COOKIE_SECURE must be True outside development.
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=example.com
AUTH_COOKIE_PATH=/
AUTH_REFRESH_COOKIE_NAME=erp_refresh_token
AUTH_CSRF_COOKIE_NAME=erp_csrf_token
AUTH_CSRF_HEADER_NAME=X-CSRF-Token

# ---------------------------------------------------------------------------
# Email delivery (SMTP)
# ---------------------------------------------------------------------------
# Current provider: Gmail SMTP.
#
# Gmail SMTP constraints (must be satisfied before enabling delivery):
#   * 2-Step Verification MUST be enabled on the sending Google account.
#   * Authentication uses an APP PASSWORD (not the account password).
#   * Gmail enforces daily sending limits (a few hundred/day for a
#     personal account; lower for a fresh account).
#   * Deliverability and reputation are weaker than a dedicated
#     transactional email provider. Messages may be throttled or
#     filtered. If deliverability becomes a problem, swap the provider
#     behind the email interface - no auth code changes.
#
# All values are read from the environment. No credentials are hardcoded
# anywhere in the source tree.
EMAIL_DELIVERY_ENABLED=False
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-sending-account@gmail.com
# SMTP_PASSWORD="your gmail app password"   # 16 characters, no spaces
# SMTP_FROM_ADDRESS=your-sending-account@gmail.com
# SMTP_USE_TLS=True      # STARTTLS on port 587 (Gmail's default)
# SMTP_USE_SSL=False     # Implicit TLS on port 465; mutually exclusive with TLS

# Database (defaults to a local SQLite file if unset - fine for dev/CI).
# In production, point this at Postgres, e.g.:
DATABASE_URL="postgresql://your url here"
# DATABASE_URL="sqlite:///output/erp_agent.db"

# S3-compatible client
# S3_BUCKET_NAME=your-bucket-name
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=auto              # or e.g. us-east-1 for real AWS S3
# S3_ENDPOINT_URL=...         # only for R2/MinIO — omit entirely for real AWS S3
# MAX_UPLOAD_SIZE_MB=15       # optional, defaults to 15